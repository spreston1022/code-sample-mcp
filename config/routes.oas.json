{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "My Zuplo API"
  },
  "paths": {
    "/mcp/example": {
      "get,post": {
        "summary": "Example MCP Server",
        "description": "Proxies MCP traffic to the example upstream MCP server, secured with OAuth and role-based tool access.",
        "operationId": "example-mcp-server",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "module": "$import(@zuplo/runtime/mcp-gateway)",
            "export": "McpProxyHandler",
            "options": {
              "rewritePattern": "https://mcp.example.com/mcp"
            }
          },
          "policies": {
            "inbound": [
              "oidc-managed-oauth",
              "mcp-token-exchange-example",
              "mcp-capability-filter-example"
            ]
          }
        }
      }
    }
  }
}
